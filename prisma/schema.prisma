generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Neon Postgres in production. For local dev, either point at the same
  // Neon DB or swap this back to "sqlite" with DATABASE_URL="file:./dev.db".
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SiteSettings {
  id           Int    @id @default(1)
  heroMediaUrl String @default("")
}

model WorkItem {
  id       String @id @default(cuid())
  brand    String
  role     String
  imageUrl String
  order    Int    @default(0)
}

model GalleryPhoto {
  id       String @id @default(cuid())
  imageUrl String
  order    Int    @default(0)
}
