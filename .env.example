# Public origin, used for canonical URLs, hreflang, sitemap and OG images.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Local dev: "file:./dev.db" (SQLite, zero setup). Production: Neon Postgres
# (Vercel Marketplace) — also update the datasource provider in schema.prisma.
# Unset => public pages fall back to the static defaults in lib/model-content.ts.
DATABASE_URL="file:./dev.db"

# Vercel Blob store, for admin media uploads.
BLOB_READ_WRITE_TOKEN=""

# Admin sign-in. AUTH_SECRET signs the session cookie: openssl rand -base64 32
ADMIN_PASSWORD=""
AUTH_SECRET=""
